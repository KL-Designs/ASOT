# Copy to .env at the repo root — both apps/web and apps/bot read this same file
# (apps/*/package.json scripts load it via `dotenv -e ../../.env`).

# NODE_ENV is intentionally not set here — apps/web's dev-collab/start scripts set it
# explicitly per-command (next dev/build manage it themselves), since forcing one fixed
# value here would make `npm start` (production) run in dev mode.

# ── Shared (used by both apps/web and apps/bot) ────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=ASOT
DISCORD_GUILD_ID=XXXXXXXXXXXXXXXXXXX
DISCORD_BOT_TOKEN=XXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_BASEURL=http://localhost:3000

# ── apps/web only ───────────────────────────────────────────────────────────────

# AI Providers
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXX
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXX

# Site
NEXT_PUBLIC_COLLAB_WS_URL=http://localhost:3000/collab

# Discord OAuth (login flow)
DISCORD_CLIENT_ID=XXXXXXXXXXXXXXXXXXX
DISCORD_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXX
DISCORD_REDIRECT_URI=/login/callback
DISCORD_SCOPE=identify
DISCORD_J1_RECRUITMENT_CHANNEL_ID=XXXXXXXXXXXXXXXXXXX
DISCORD_J4_ROLE_ID=XXXXXXXXXXXXXXXXXXX

# TeamSpeak
NEXT_PUBLIC_TS_ADDRESS=ts.yourdomain.com
TS_HOST=your-teamspeak-server-ip
TS_QUERY_PORT=10022
TS_SERVER_PORT=9987
TS_SERVERADMIN_PASSWORD=XXXXXXXXXXXXXXXXXXX

# Backups (restic)
RESTIC_PASSWORD=XXXXXXXXXXXXXXXXXXX

# OCAP
OCAP_API_URL=http://your-ocap-server:5000
OCAP_VIEWER_URL=https://ocap.yourdomain.com

# Cron / dev
CRON_SECRET=XXXXXXXXXXXXXXXXXXX
ANALYZE=false
WIP_PAGES=false
OVERRIDE=240786290600181761,683343114865606686,224086573560365057
TS_OVERRIDE=uid1,uid2

# ── apps/bot only ────────────────────────────────────────────────────────────────
DISCORD_MEMBER_ROLE_ID=XXXXXXXXXXXXXXXXXXX
DISCORD_ADMIN_ROLE_ID=
DISCORD_NOTIFICATION_CHANNEL_ID=
DISCORD_SONG_SUBMISSION_CHANNEL_ID=

# ── apps/milpac (shared: web calls the service, the service reads the token) ─────
# The renderer runs on the internal Docker network with no published port, so
# this URL is only resolvable from inside the compose stack. MILPAC_PORT is the
# service's own listen port and must match the host in MILPAC_SERVICE_URL.
MILPAC_SERVICE_URL=http://milpac:42070
MILPAC_SERVICE_TOKEN=XXXXXXXXXXXXXXXXXXX
MILPAC_PORT=42070
