# Copy to .env at the repo root — both apps/web and apps/bot read this same file
# (apps/*/package.json scripts load it via `dotenv -e ../../.env`).

# NODE_ENV is intentionally not set here — apps/web's dev-collab/start scripts set it
# explicitly per-command (next dev/build manage it themselves), since forcing one fixed
# value here would make `npm start` (production) run in dev mode.

# NEXT_PUBLIC_DEV_TOOLS=true puts the developer tools (attendance data generator,
# template document) on a *built* site. NODE_ENV cannot do this: Next bakes it into
# the client bundle at build time and `next build` fixes it at "production", so those
# controls are compiled out — and starting server.mjs with NODE_ENV=development runs
# the dev compiler instead of serving the build. Set it here and both `npm run build`
# and `npm start` see it, which they must: the client's copy is baked in at build
# time, so setting it only at start would light up the API routes with no buttons to
# call them. Leave it unset for the real deployment. See apps/web/lib/dev-tools.ts.

# ── Shared (used by both apps/web and apps/bot) ────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=ASOT
DISCORD_GUILD_ID=XXXXXXXXXXXXXXXXXXX
DISCORD_BOT_TOKEN=XXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_BASEURL=http://localhost:3000

# ── apps/web only ───────────────────────────────────────────────────────────────

# AI Providers
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXX
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXX

# Site
NEXT_PUBLIC_COLLAB_WS_URL=http://localhost:3000/collab

# Discord OAuth (login flow)
DISCORD_CLIENT_ID=XXXXXXXXXXXXXXXXXXX
DISCORD_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXX
DISCORD_REDIRECT_URI=/login/callback
DISCORD_SCOPE=identify
DISCORD_J1_RECRUITMENT_CHANNEL_ID=XXXXXXXXXXXXXXXXXXX
DISCORD_J4_ROLE_ID=XXXXXXXXXXXXXXXXXXX

# TeamSpeak
NEXT_PUBLIC_TS_ADDRESS=ts.yourdomain.com
TS_HOST=your-teamspeak-server-ip
TS_QUERY_PORT=10022
TS_SERVER_PORT=9987
TS_SERVERADMIN_PASSWORD=XXXXXXXXXXXXXXXXXXX

# Backups (restic)
RESTIC_PASSWORD=XXXXXXXXXXXXXXXXXXX

# OCAP
OCAP_API_URL=http://your-ocap-server:5000
OCAP_VIEWER_URL=https://ocap.yourdomain.com

# Optional, apps/web only. Without these a submitted Twitch clip gets a
# generated placeholder thumbnail instead of the real one — everything else
# about it works. Create an application at https://dev.twitch.tv/console/apps.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Cron / dev
CRON_SECRET=XXXXXXXXXXXXXXXXXXX
ANALYZE=false
WIP_PAGES=false
OVERRIDE=240786290600181761,683343114865606686,224086573560365057
TS_OVERRIDE=uid1,uid2

# ── apps/bot only ────────────────────────────────────────────────────────────────
DISCORD_MEMBER_ROLE_ID=XXXXXXXXXXXXXXXXXXX
DISCORD_ADMIN_ROLE_ID=
DISCORD_NOTIFICATION_CHANNEL_ID=
DISCORD_SONG_SUBMISSION_CHANNEL_ID=

# Shared secret for the routes the bot calls on apps/web server-to-server —
# currently /api/bot/milpac, behind `/milpac uniform` and `/milpac medals`.
# Both apps read this one value, so it has to match. Unset closes the route and
# the commands say so rather than failing silently. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_API_SECRET=XXXXXXXXXXXXXXXXXXX

# Where the bot reaches web for those calls. This DEV value assumes both are on
# localhost; docker-compose.yml overrides it to http://web:3000 on the bot
# service, since inside compose the public URL would leave the network and come
# back through the reverse proxy. NEXT_PUBLIC_BASEURL stays the public address
# and is what member-facing links use — both are needed, for different things.
WEB_INTERNAL_URL=http://localhost:3000

# ── apps/milpac (shared: web calls the service, the service reads the token) ─────
# MILPAC_SERVICE_URL is the DEV value: running `npm start` locally, the service
# is a plain process on localhost. In Docker it is unreachable by that name, so
# docker-compose.yml overrides it to http://milpac:42070 on the web service —
# the container publishes no port and is only addressable by service name.
# MILPAC_PORT is the service's own listen port and must match the URL's port.
MILPAC_SERVICE_URL=http://localhost:42070
MILPAC_SERVICE_TOKEN=XXXXXXXXXXXXXXXXXXX
MILPAC_PORT=42070

# The certificate signing officer is NOT configured here. It is the officer
# recorded against that award or promotion in the member's milpac, falling back
# to whoever holds the ORBAT position chosen in the dashboard under
# J4 → Website Settings → Certificates. The former MILPAC_SIGNATORY_NAME /
# _RANK_SHORT / _RANK_FULL variables are gone — delete them from your .env.
