# Build context is the repo root (see docker-compose.yml) — apps/bot is the sole npm
# workspace member, so its lockfile is the root package-lock.json, not a local one.

FROM node:22-alpine

# ffmpeg/yt-dlp/python3 for the song-submission command.
RUN apk add --no-cache ffmpeg curl python3 \
    && curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod +x /usr/local/bin/yt-dlp

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/bot/package.json apps/bot/package.json
RUN npm install

COPY apps/bot/ ./apps/bot/
COPY .env ./.env

WORKDIR /app/apps/bot
CMD ["sh", "-c", "yt-dlp -U || true && npm start"]
