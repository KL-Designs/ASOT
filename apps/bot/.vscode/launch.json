{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Deno App",
            "type": "pwa-node",
            "request": "launch",
            "program": "${workspaceFolder}/index.ts", // Adjust to your entry point file
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "deno",
            "runtimeArgs": [
                "run",
                "--inspect-brk",
                "--allow-all"
            ],
            "attachSimplePort": 9229,
            "outputCapture": "std"
        }
    ]
}
