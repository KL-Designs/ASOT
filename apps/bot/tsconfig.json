{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    // Node10 (and the baseUrl-based path resolution it implies) is deprecated — removal
    // planned for TS 7.0 — but still fully functional today. Kept deliberately: it's what
    // makes `import Discord from 'discord.js'`-style default imports work via
    // esModuleInterop's CJS synthetic-default (discord.js has no true default export) —
    // switching to node16/nodenext now risks reintroducing that break for no current
    // benefit. Revisit if/when actually migrating off Node10.
    "ignoreDeprecations": "5.0",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "app": ["./app/index.ts"],
      "config": ["./lib/config.ts"],
      "mongo": ["./lib/mongo.ts"],
      "encryption": ["./lib/encryption.ts"],
      "configurations": ["./config/index.ts"],
      "lib/*": ["./lib/*"],
      "modals/*": ["./app/modals/*"],
      "discord/modules": ["./app/modules/index.ts"],
      "discord/events": ["./app/events/index.ts"],
      "discord/commands": ["./app/commands/index.ts"],
      "discord/buttons": ["./app/interactions/buttons/index.ts"],
      "discord/modals": ["./app/interactions/modals/index.ts"],
      "discord/stringSelectMenus": ["./app/interactions/stringSelectMenus/index.ts"],
      "discord/mentionableSelectMenus": ["./app/interactions/mentionableSelectMenus/index.ts"]
    }
  },
  "include": ["**/*.ts", "../../types/**/*.ts"],
  "exclude": ["node_modules"]
}
