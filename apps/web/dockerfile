# syntax=docker/dockerfile:1
# Build context is the repo root (see docker-compose.yml) — apps/web needs the shared
# root .env at build time too, since NEXT_PUBLIC_* vars get inlined into the client bundle.

FROM node:22-alpine

# node:22-alpine bundles an older npm than modern dev machines commonly have (10.x vs 11.x).
# npm 11 records some lockfile entries (e.g. optional peer deps) differently than npm 10
# expects, so `npm ci` on a lockfile written by npm 11 can fail on npm 10 with a false
# "not in sync" error even though the file is completely valid. Pin a matching modern
# version here instead of trusting whatever the base image happens to ship.
RUN npm install -g npm@11

WORKDIR /app

# `playwright` is a real (non-dev) dependency here but is only ever used by the standalone
# scripts/scrape-milpacs.mjs maintenance script, never by the running site — its default
# postinstall downloads Chromium/Firefox/WebKit (300-500MB) which was most of this image's
# multi-minute install time. Skip that; npm ci also skips dependency resolution (we already
# have an exact lockfile), which is faster and more reproducible than npm install for a build.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# apps/web is not an npm workspace member (it has its own hoisting-sensitive build —
# see next.config.ts's outputFileTracingRoot comment) — install it independently.
# The cache mount persists npm's package cache across separate `docker build` runs
# (not just within one build) — layer caching alone only helps when this COPY's
# inputs are byte-identical to a previous build, this helps even when they aren't.
COPY apps/web/package.json apps/web/package-lock.json ./apps/web/
RUN --mount=type=cache,target=/root/.npm \
    cd apps/web && npm ci --no-audit --no-fund

# Terrain generation — separate layer so it only re-runs when storage/maps or scripts/
# change, not on every app code change. storage/maps lives at the monorepo root (see
# storage/README.md) but still gets baked into this image at build time, unlike the
# other storage/ subfolders which are pure runtime data mounted via docker-compose.yml.
COPY storage/maps/ ./storage/maps/
COPY apps/web/scripts/ ./apps/web/scripts/
RUN cd apps/web && node scripts/generate-terrain.mjs

# Copy the rest of apps/web, the shared .env, and the shared types/ (referenced via
# apps/web/tsconfig.json's "../../types/**/*.ts" include — see types/README.md), then build.
COPY apps/web/ ./apps/web/
COPY types/ ./types/
COPY .env ./.env

WORKDIR /app/apps/web
# Next's own incremental build cache (SWC/webpack) — also persisted across builds via
# a cache mount, so unrelated code changes don't force a full from-scratch recompile.
RUN --mount=type=cache,target=/app/apps/web/.next/cache \
    NODE_OPTIONS="--max-old-space-size=2048" npm run build

EXPOSE 3000
CMD ["npm", "start"]
