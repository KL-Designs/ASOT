{
  "name": "asot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev",
    "dev-collab": "dotenv -v NODE_ENV=development -e ../../.env -- node --max-old-space-size=4096 server.mjs",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -v NODE_ENV=production -e ../../.env -- node server.mjs",
    "build:devtools": "dotenv -v NEXT_PUBLIC_DEV_TOOLS=true -e ../../.env -- next build",
    "start:devtools": "dotenv -v NODE_ENV=production -v NEXT_PUBLIC_DEV_TOOLS=true -e ../../.env -- node server.mjs",
    "lint": "next lint",
    "import:history": "dotenv -e ../../.env -- tsx scripts/import-member-history.ts",
    "sync:ranks": "dotenv -e ../../.env -- tsx scripts/sync-orbat-ranks.ts",
    "import:quals": "dotenv -e ../../.env -- tsx scripts/import-ts-qualifications.ts",
    "dedupe:milpac": "dotenv -e ../../.env -- tsx scripts/dedupe-milpac-records.ts",
    "reconcile:gallery": "dotenv -e ../../.env -- tsx scripts/reconcile-gallery.ts",
    "strip:folder-numbers": "dotenv -e ../../.env -- tsx scripts/strip-folder-numbers.ts",
    "backfill:featured-order": "dotenv -e ../../.env -- tsx scripts/backfill-featured-order.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
