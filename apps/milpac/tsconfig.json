{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "lib": ["ES2022"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "types": ["node"],
        "paths": {
            "@asot/lib": ["../../lib/index.ts"]
        }
    },
    "include": ["src/**/*.ts", "scripts/**/*.ts", "../../lib/**/*.ts"]
}
