{
  "name": "milpac",
  "version": "1.0.0",
  "private": true,
  "description": "Stateless MilPac image renderer \u2014 uniforms, medal boxes and certificates",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "start": "dotenv -e ../../.env -- tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "extract-layouts": "tsx scripts/extract-certificate-layouts.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "dotenv-cli": "^7.4.4",
    "pizzip": "^3.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
