{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start Menu",
            "type": "node-terminal",
            "request": "launch",
            "command": "node scripts/start.mjs",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Web: Dev + Collab",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev-collab",
            "cwd": "${workspaceFolder}/apps/web"
        },
        {
            "name": "Bot: Dev",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/apps/bot"
        }
    ],
    "compounds": [
        {
            "name": "Web + Bot: Dev",
            "configurations": ["Web: Dev + Collab", "Bot: Dev"],
            "stopAll": true
        }
    ]
}
