{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start Menu",
            "type": "node-terminal",
            "request": "launch",
            "command": "node scripts/start.mjs",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Web: Dev",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev-collab",
            "cwd": "${workspaceFolder}/apps/web"
        },
        {
            "name": "Milpac: Dev",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/apps/milpac"
        },
        {
            "name": "Bot: Dev",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/apps/bot"
        }
    ],
    "compounds": [
        {
            "name": "Web + Milpac",
            "configurations": ["Web: Dev", "Milpac: Dev"],
            "stopAll": true
        },
        {
            "name": "Web + Milpac + Bot",
            "configurations": ["Web: Dev", "Milpac: Dev", "Bot: Dev"],
            "stopAll": true
        }
    ]
}
